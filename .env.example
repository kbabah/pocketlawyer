# Rate limiting (optional — falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
ADMIN_SETUP_SECRET=

# reCAPTCHA (optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Payments (optional — sandbox auto-enabled in development without MTN keys)
NEXT_PUBLIC_PAYMENTS_ENABLED=
PAYMENTS_SANDBOX=true
MTN_API_KEY=
MTN_API_URL=
MTN_API_TOKEN=
MTN_ENVIRONMENT=sandbox
ORANGE_API_KEY=
